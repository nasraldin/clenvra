      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التنسيق"
          }
        }
      }
    },
    "Found through the app's group or its exact name. Selected only when no other app may use it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عُثر عليه من خلال مجموعة التطبيق أو اسمه المطابق. يُحدَّد فقط إذا لم يكن أي تطبيق آخر قد يستخدمه."
          }

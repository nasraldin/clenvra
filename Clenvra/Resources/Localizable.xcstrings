    "System-wide logs older than a week. Removed through the System Helper; old compressed logs are deleted for good.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجلات النظام الأقدم من أسبوع. تُزال عبر مساعد النظام؛ وتُحذف السجلات القديمة المضغوطة نهائيًا."
          }
        }
      }
    },
    "Temporary files apps create to load faster. Apps rebuild them when needed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات مؤقتة تنشئها التطبيقات لتعمل بسرعة أكبر. تعيد التطبيقات إنشاءها عند الحاجة."
          }
        }
      }
    },
    "The app and %lld of its items will be moved to the Trash.": {
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "سيُنقل التطبيق و%lld عناصر من عناصره إلى سلة المهملات."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "سيُنقل التطبيق و%lld عنصرًا من عناصره إلى سلة المهملات."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "سيُنقل التطبيق وعنصر واحد من عناصره إلى سلة المهملات."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "سيُنقل التطبيق و%lld عنصر من عناصره إلى سلة المهملات."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "سيُنقل التطبيق وعنصران من عناصره إلى سلة المهملات."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "سيُنقل التطبيق وحده إلى سلة المهملات، دون أي عناصر أخرى."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The app and %lld of its items will be moved to the Trash."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The app and %lld of its items will be moved to the Trash."
                }
              }
            }
          }
        }
      }
    },
    "The app is open, or it changed after you reviewed it. Quit it and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيق مفتوح، أو تغيّر بعد مراجعتك له. قم بإنهائه وحاول مرة أخرى."
          }
        }
      }
    },
    "The app that uses it is open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيق الذي يستخدمه مفتوح."
          }
        }
      }
    },
    "The command did not finish successfully": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل الأمر بنجاح"
          }
        }

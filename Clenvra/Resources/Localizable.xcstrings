    "System Junk": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات النظام غير الضرورية"
          }
        }
      }
    },
    "System Logs": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجلات النظام"
          }
        }
      }
    },
    "System Performance": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أداء النظام"
          }
        }
      }
    },
    "System-wide logs older than a week. Removed through the System Helper; old compressed logs are deleted for good.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجلات النظام الأقدم من أسبوع. تُزال عبر مساعد النظام؛ وتُحذف السجلات القديمة المضغوطة نهائيًا."
          }
        }
      }
    },
    "Temporary Files": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملفات المؤقتة"
          }
        }
      }
    },
    "Temporary files apps create to load faster. Apps rebuild them when needed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات مؤقتة تنشئها التطبيقات لتعمل بسرعة أكبر. تعيد التطبيقات إنشاءها عند الحاجة."
          }
        }
      }
    },
    "The Android Emulator application and support files.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق محاكي Android وملفات الدعم."
          }
        }
      }
    },
    "The app and %lld of its items will be moved to the Trash.": {
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "سيُنقل التطبيق و%lld عناصر من عناصره إلى سلة المهملات."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "سيُنقل التطبيق و%lld عنصرًا من عناصره إلى سلة المهملات."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "سيُنقل التطبيق وعنصر واحد من عناصره إلى سلة المهملات."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "سيُنقل التطبيق و%lld عنصر من عناصره إلى سلة المهملات."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "سيُنقل التطبيق وعنصران من عناصره إلى سلة المهملات."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "سيُنقل التطبيق وحده إلى سلة المهملات، دون أي عناصر أخرى."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The app and %lld of its items will be moved to the Trash."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The app and %lld of its items will be moved to the Trash."
                }
              }
            }
          }
        }
      }
    },
    "The app is open, or it changed after you reviewed it. Quit it and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيق مفتوح، أو تغيّر بعد مراجعتك له. قم بإنهائه وحاول مرة أخرى."
          }
        }
      }
    },
    "The app starts as if it were opened for the first time. Every item is checked again just before it is moved. You can put items back from Activity.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ التطبيق كما لو فُتح لأول مرة. يُتحقق من كل عنصر مرة أخرى قبل نقله مباشرة. يمكنك إعادة العناصر من النشاط."
          }
        }
      }
    },
    "The app that uses it is open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيق الذي يستخدمه مفتوح."
          }
        }
      }
    },
    "The backup could not be moved to the Trash.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر نقل النسخة الاحتياطية إلى سلة المهملات."
          }
        }
      }
    },
    "The backup of %@ can no longer be restored once the Trash is emptied.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن استعادة النسخة الاحتياطية لـ %@ بعد إفراغ سلة المهملات."
          }
        }
      }
    },
    "The command did not finish successfully": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل الأمر بنجاح"
          }
        }
      }
    },
    "The file could not be written.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت كتابة الملف."
          }
        }
      }
    },
    "The folder it came from no longer exists.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد المجلد الذي كان فيه هذا العنصر موجودًا."
          }
        }
      }
    },
    "The helper is installed but did not answer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المساعد مثبّت لكنه لم يستجب."
          }
        }
      }
    },
    "The installed helper is from another version of Clenvra. Remove it and install it again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المساعد المثبّت من إصدار آخر من Clenvra. أزله ثم ثبّته مرة أخرى."
          }
        }
      }
    },
    "The item in the Trash was not the one checked, so the cleanup was stopped.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العنصر الموجود في سلة المهملات ليس العنصر الذي تم فحصه، لذلك أُوقف التنظيف."
          }
        }
      }
    },
    "The item was stopped and moved to the Trash.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف العنصر ونقله إلى سلة المهملات."
          }
        }
      }
    },
    "The name looks related. Never selected automatically, so check before removing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو الاسم مرتبطًا. لا يُحدَّد تلقائيًا أبدًا، لذا تحقّق منه قبل الإزالة."
          }
        }
      }
    },
    "The rule could not be saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ القاعدة."
          }
        }
      }
    },
    "The scan was stopped before it finished.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف الفحص قبل اكتماله."
          }
        }
      }
    },
    "The scan was stopped. Results may be incomplete.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف الفحص. قد تكون النتائج غير مكتملة."
          }
        }
      }
    },
    "The settings could not be exported.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تصدير الإعدادات."
          }
        }
      }
    },
    "The settings could not be saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ الإعدادات."
          }
        }
      }
    },
    "The snapshot could not be deleted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حذف اللقطة."
          }
        }
      }
    },
    "The tool’s own command can shrink it: ⁦%@⁩": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للأمر الخاص بالأداة تقليصه: ⁦%@⁩"
          }
        }
      }
    },
    "The update check for this app didn't finish. Check your connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل التحقق من تحديثات هذا التطبيق. تحقق من اتصالك وحاول مرة أخرى."
          }
        }
      }
    },
    "The update source answered in a way Clenvra doesn't understand.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجاب مصدر التحديثات بطريقة لا يفهمها Clenvra."
          }
        }
      }
    },
    "Then choose Firewall.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثم اختر جدار الحماية."
          }
        }
      }
    },
    "There are no screenshots or screen recordings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد لقطات شاشة أو تسجيلات شاشة."
          }
        }
      }
    },
    "Thermal State": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحالة الحرارية"
          }
        }
      }
    },
    "These copies share storage; removing them frees almost nothing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتشارك هذه النسخ مساحة التخزين نفسها، لذا لن تؤدي إزالتها إلى تحرير مساحة تُذكر."
          }
        }
      }
    },
    "They run one after another, in this order.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل واحدًا تلو الآخر بهذا الترتيب."
          }
        }
      }
    },
    "This Copy": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه النسخة"
          }
        }
      }
    },
    "This app is part of macOS or Clenvra, so it can't be removed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا التطبيق جزء من macOS أو من Clenvra، لذا لا يمكن إزالته."
          }
        }
      }
    },
    "This app is up to date.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا التطبيق محدّث."
          }
        }
      }
    },
    "This app's update feed doesn't use a secure connection, so Clenvra didn't contact it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصدر تحديثات هذا التطبيق لا يستخدم اتصالًا آمنًا، لذا لم يتصل به Clenvra."
          }
        }
      }
    },
    "This does not use the Trash and cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستخدم هذا سلة المهملات ولا يمكن التراجع عنه."
          }
        }
      }
    },
    "This entry does not describe an item in the Trash.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يصف هذا السجل عنصرًا في سلة المهملات."
          }
        }
      }
    },
    "This file is not a Clenvra settings file.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف ليس ملف إعدادات Clenvra."
          }
        }
      }
    },
    "This file was made by a newer version of Clenvra.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُنشئ هذا الملف بإصدار أحدث من Clenvra."
          }
        }
      }
    },
    "This folder is empty": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المجلد فارغ"
          }
        }
      }
    },
    "This frees about %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي ذلك إلى تحرير نحو %@."
          }
        }
      }
    },
    "This item is no longer in the Trash.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد هذا العنصر موجودًا في سلة المهملات."
          }
        }
      }
    },
    "This location is not allowed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الموقع غير مسموح به."
          }
        }
      }
    },
    "This process has quit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت هذه العملية."
          }
        }
      }
    },
    "This user": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المستخدم"
          }
        }
      }
    },
    "Threads": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سلاسل التنفيذ"
          }
        }
      }
    },
    "Time": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوقت"
          }
        }
      }
    },
    "Time Machine and macOS updates keep these copies of your disk for a while.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ Time Machine وتحديثات macOS بهذه النسخ من قرصك لبعض الوقت."
          }
        }
      }
    },
    "Toolbar buttons show only their icon. Point to a button to see its name.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُظهر أزرار شريط الأدوات أيقوناتها فقط. أشر إلى زر لترى اسمه."
          }
        }
      }
    },
    "Toolbar:": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",

            "value": "حدّثه من App Store."
          }
        }
      }
    },
    "Updates": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحديثات"
          }
        }
      }
    },
    "Updating sizes after the cleanup…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ تحديث الأحجام بعد التنظيف…"

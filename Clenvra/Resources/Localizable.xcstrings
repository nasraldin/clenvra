    "Stop and Move to Trash": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف ونقل إلى سلة المهملات"
          }
        }
      }
    },
    "Stop and Start apply to this login only. Remove stops it and moves its file to the Trash.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسري الإيقاف والتشغيل على جلسة تسجيل الدخول هذه فقط. أما الإزالة فتوقفه وتنقل ملفه إلى سلة المهملات."
          }
        }
      }
    },
    "Stop the scan (Esc)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف الفحص (Esc)"
          }
        }
      }
    },
    "Stopped for now. It starts again at your next login.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُوقف الآن. سيعمل مجددًا عند تسجيل الدخول التالي."
          }
        }
      }
    },
    "Storage": {
      "localizations": {
        "ar": {
          "stringUnit": {

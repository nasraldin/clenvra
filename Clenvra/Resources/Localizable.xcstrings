            "state": "new",
            "value": "%1$@ available of %2$@"
          }
        }
      }
    },
    "%@ could not be ejected. A file on it may be open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إخراج %@. قد يكون ملف عليه مفتوحًا."

    "Part of macOS. Clenvra never removes it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جزء من macOS. لا يزيله Clenvra أبدًا."
          }
        }
      }
    },
    "Partial results: the scan was stopped before it finished, so sizes may be too small.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نتائج جزئية: تم إيقاف الفحص قبل اكتماله، لذا قد تكون الأحجام أصغر من الحقيقية."
          }
        }
      }
    },

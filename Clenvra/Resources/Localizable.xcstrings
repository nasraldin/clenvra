    "Suggested to keep, %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقترح الاحتفاظ بها، %@"
          }
        }
      }
    },
    "Suggested to keep: the most pixels, then the newest.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقترح الاحتفاظ بها: الأعلى دقة، ثم الأحدث."

    },
    "Unused for 6 Months": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير مستخدمة منذ 6 أشهر"
          }
        }
      }
    },
    "Updating sizes after the cleanup…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ تحديث الأحجام بعد التنظيف…"
          }
        }
      }
    },
    "Uptime": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدة التشغيل"
          }
        }
      }
    },
    "Use on Another Mac": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستخدام على جهاز Mac آخر"
          }
        }
      }
    },
    "Used %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستخدم %@"
          }

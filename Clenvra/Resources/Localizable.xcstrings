    "Clenvra never asks for your password, never runs in the background, and sends nothing off your Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يطلب Clenvra كلمة السر أبدًا، ولا يعمل في الخلفية، ولا يرسل أي شيء خارج جهاز Mac."
          }

    "Cleanup and other actions Clenvra performs will appear here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا إجراءات التنظيف والإجراءات الأخرى التي ينفّذها Clenvra."
          }

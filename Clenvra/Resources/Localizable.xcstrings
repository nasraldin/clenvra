    "%@ still has access to %@. Change it in System Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال %1$@ يملك الوصول إلى %2$@. غيّر ذلك في إعدادات النظام."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ still has access to %2$@. Change it in System Settings."
          }
        }
      }
    },
    "%@ will lose access to %@. macOS asks again the next time it needs it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيفقد %1$@ الوصول إلى %2$@. سيطلب macOS الإذن مجددًا عندما يحتاجه التطبيق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ will lose access to %2$@. macOS asks again the next time it needs it."
          }
        }
      }
    },

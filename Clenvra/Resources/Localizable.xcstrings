    "“%@” is in the Trash": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@“ في سلة المهملات"
          }
        }
      }
    },
    "⁨%@⁩ is not selected automatically. Check whether you still need it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُحدَّد ⁨%@⁩ تلقائيًا. تحقّق مما إذا كنت لا تزال بحاجة إليه."
          }
        }

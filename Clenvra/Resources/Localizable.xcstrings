    "Removed Permanently": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت الإزالة نهائيًا"
          }
        }
      }
    },
    "Removes Bun's download cache. Packages are downloaded again when needed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل ذاكرة التخزين المؤقت لتنزيلات Bun. يُعاد تنزيل الحزم عند الحاجة."
          }
        }
      }
    },
    "Removes Colima's cached downloads, such as VM images. Virtual machines and their disks are not touched.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل تنزيلات Colima المخزنة مؤقتًا، مثل صور الآلات الافتراضية. لا تُمس الآلات الافتراضية ولا أقراصها."
          }
        }
      }
    },
    "Removes NuGet's package and download caches. Packages are downloaded again on the next restore.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل ذاكرات NuGet المؤقتة للحزم والتنزيلات. تُنزَّل الحزم مجددًا عند الاستعادة التالية."
          }
        }
      }
    },
    "Removes SwiftPM's shared cache of package checkouts. Packages are downloaded again when needed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل الذاكرة المؤقتة المشتركة لنسخ حزم SwiftPM. تُنزَّل الحزم مجددًا عند الحاجة."
          }
        }
      }
    },
    "Removes Yarn's download cache. Packages are downloaded again when needed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل ذاكرة التخزين المؤقت لتنزيلات Yarn. يُعاد تنزيل الحزم عند الحاجة."
          }
        }
      }
    },
    "Removes conda's cached package downloads and packages no environment uses. Environments are not changed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل تنزيلات الحزم المخزنة مؤقتًا في conda والحزم التي لا تستخدمها أي بيئة. لا تتغير البيئات."
          }
        }
      }
    },
    "Removes dangling images only: untagged layers that no image or container uses.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل الصور المعلّقة فقط: طبقات بلا وسم لا تستخدمها أي صورة أو حاوية."
          }
        }
      }
    },
    "Removes downloaded pods. They are downloaded again on the next pod install.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل حزم Pods المنزّلة. يُعاد تنزيلها عند تنفيذ pod install التالي."
          }
        }
      }
    },
    "Removes every downloaded Go module. Builds download them again, which can take a while.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل كل وحدات Go المنزّلة. يعيد البناء تنزيلها، وقد يستغرق ذلك بعض الوقت."
          }
        }
      }
    },
    "Removes npm's download cache. Packages are downloaded again when needed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل ذاكرة التخزين المؤقت لتنزيلات npm. يُعاد تنزيل الحزم عند الحاجة."
          }
        }
      }
    },
    "Removes old versions of installed packages and cached downloads.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل الإصدارات القديمة من الحزم المثبتة والتنزيلات المخزّنة مؤقتًا."
          }
        }
      }
    },
    "Removes packages no project references. They are downloaded again when needed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل الحزم التي لا يشير إليها أي مشروع. يُعاد تنزيلها عند الحاجة."
          }
        }
      }
    },
    "Removes pip's cache of downloaded and built packages. They are downloaded again when needed.": {
      "localizations": {
